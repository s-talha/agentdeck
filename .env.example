# Postgres (matches docker-compose.yml)
DATABASE_URL="postgresql://agentdeck:agentdeck@localhost:5432/agentdeck?schema=public"

# Auth.js: generate with `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET=""

# Optional: enables "Continue with GitHub". Callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Optional: real model runs. Without a key, agents run on the built-in offline demo model.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"

# Runs allowed per user per hour
RUNS_PER_HOUR="30"
